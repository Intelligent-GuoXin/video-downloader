{
  "manifest_version": 3,
  "name": "视频嗅探下载器",
  "version": "0.5.0",
  "description": "自动识别页面中的视频并提供下载：支持直链与 HLS，音视频分离自动合并，纯 JS 无损转封装。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "scripting",
    "webRequest",
    "declarativeNetRequest",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "视频嗅探下载器"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
